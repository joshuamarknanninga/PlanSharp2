{
  "expo": {
    "name": "PlanSharp",
    "slug": "plansharp",
    "scheme": "plansharp",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "ios": {"supportsTablet": true, "bundleIdentifier": "com.plansharp.app"},
    "android": {"package": "com.plansharp.app"},
    "plugins": ["expo-camera", "expo-secure-store"],
    "extra": {"apiUrl": "http://localhost:4000/api"}
  }
}
