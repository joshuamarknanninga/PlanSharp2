{
  "name": "plansharp",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "backend"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace apps/mobile run start",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:backend": "npm --workspace backend run dev",
    "lint": "npm run lint -ws",
    "test": "npm run test -ws",
    "format": "npm run format -ws"
  }
}
